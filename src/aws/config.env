# Shared settings for the deployment scripts. Edit before the first deploy.
export AWS_REGION="${AWS_REGION:-ap-southeast-2}"  # Sydney; any region with SageMaker works
export PROJECT="${PROJECT:-drugresp}"               # lowercase, used in resource names
export STACK="${STACK:-drugresp-stack}"
export ALERT_EMAIL="${ALERT_EMAIL:-}"               # optional: receives CloudWatch alarm e-mails
export INFERENCE_MODE="${INFERENCE_MODE:-local}"    # local = model runs on EC2, sagemaker = endpoint
export FREE_TIER_ONLY="${FREE_TIER_ONLY:-true}"     # true = no SageMaker anywhere; everything stays in the free tier
export INSTANCE_TYPE="${INSTANCE_TYPE:-t3.small}"   # free-tier eligible; 2 GB RAM (+4 GB swap) fits torch + RDKit
